<UserControl x:Class="NovaPlayer.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,24" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,22" />
            <TextBlock Text="播放设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.AutoResume}" />
                        <StackPanel>
                            <TextBlock Text="自动续播" />
                            <TextBlock Text="再次打开时，恢复已保存的有效观看位置" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,12,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding ResumeModes}" SelectedItem="{Binding Preferences.ResumeMode}" />
                        <TextBlock Text="续播模式" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.RememberSpeed}" />
                        <TextBlock Text="记忆独立视频倍速" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding PlaybackModes}" SelectedIndex="{Binding PlaybackModeIndex}" />
                        <TextBlock Text="播放结束后" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding Speeds}" ItemTemplate="{StaticResource SpeedValueTemplate}" SelectedItem="{Binding Preferences.DefaultSpeed}" />
                        <StackPanel>
                            <TextBlock Text="默认倍速" />
                            <TextBlock Text="用于尚未记录独立倍速的视频" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,12,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding SeekIntervals}" SelectedItem="{Binding Preferences.SeekInterval}" />
                        <TextBlock Text="快进 / 快退间隔（秒）" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.AutoLoadSubtitles}" />
                        <TextBlock Text="自动加载同名字幕（下次打开生效）" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.HardwareDecoding}" />
                        <TextBlock Text="优先硬件解码，失败回退软件（下次打开生效）" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.PitchCorrection}" />
                        <TextBlock Text="音调修正" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.AutoMuteHighSpeed}" />
                        <TextBlock Text="超过 8 倍速自动静音" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Slider Width="160" Minimum="20" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Preferences.SubtitleSize}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Preferences.SubtitleSize, StringFormat={}{0:0}}" Width="30" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="字幕字号（ASS 保留样式等比例缩放）" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="外观设置" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,12" />
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ComboBox DockPanel.Dock="Right" Width="130" ItemsSource="{Binding Themes}" SelectedItem="{Binding Preferences.Theme}" />
                        <TextBlock Text="主题" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.PlaylistExpanded}" />
                        <TextBlock Text="展开播放列表" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.InformationExpanded}" />
                        <TextBlock Text="显示底部信息区" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.AlwaysOnTop}" />
                        <TextBlock Text="窗口置顶" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.RememberWindow}" />
                        <TextBlock Text="记住主窗口位置与尺寸" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding HideIntervals}" SelectedItem="{Binding Preferences.ControlsHideSeconds}" />
                        <TextBlock Text="全屏 / 画中画控制栏隐藏时间（秒）" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ShortcutsHeading" Text="快捷键" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,12" />
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="恢复默认快捷键" Click="ResetShortcuts_Click" />
                        <TextBlock Text="点击按键框后，直接按下新的组合键" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Shortcuts.Message}" Foreground="#E5A86A" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Shortcuts.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Display, Mode=OneWay}" IsReadOnly="True" PreviewKeyDown="CaptureShortcut_KeyDown" ToolTip="点击后按下组合键，修改立即生效" HorizontalContentAlignment="Center" />
                                    <Button Grid.Column="2" Content="清除" Tag="{Binding}" Click="ClearShortcut_Click" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Text="数据管理" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,12" />
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding History.Count, StringFormat=播放记录：{0} 条}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="打开数据库目录" Command="{Binding OpenDatabaseFolderCommand}" />
                        <Button Content="清除播放历史" Command="{Binding ClearHistoryCommand}" Margin="12,0,0,0" />
                        <Button Content="打开日志目录" Command="{Binding OpenLogsCommand}" Margin="12,0,0,0" />
                        <Button Content="恢复默认设置" Command="{Binding ResetSettingsCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
