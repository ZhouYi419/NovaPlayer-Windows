<UserControl x:Class="NovaPlayer.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,24" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,22" />
            <TextBlock Text="播放设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.AutoResume}" />
                        <StackPanel>
                            <TextBlock Text="自动续播" />
                            <TextBlock Text="再次打开时，恢复本次会话中有效的观看位置" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,12,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding Speeds}" ItemTemplate="{StaticResource SpeedValueTemplate}" SelectedItem="{Binding Preferences.DefaultSpeed}" />
                        <StackPanel>
                            <TextBlock Text="默认倍速" />
                            <TextBlock Text="用于尚未记录独立倍速的视频" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,12,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="外观设置" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,12" />
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ComboBox DockPanel.Dock="Right" Width="130" ItemsSource="{Binding Themes}" SelectedItem="{Binding Preferences.Theme}" />
                        <TextBlock Text="主题" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.PlaylistExpanded}" />
                        <TextBlock Text="展开播放列表" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.InformationExpanded}" />
                        <TextBlock Text="显示底部信息区" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.AlwaysOnTop}" />
                        <TextBlock Text="窗口置顶" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="快捷键" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,12" />
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Space    播放 / 暂停" Margin="0,0,0,12" />
                        <TextBlock Text="← / →    快退 / 快进 10 秒" Margin="0,0,0,12" />
                        <TextBlock Text="↑ / ↓    调整音量" Margin="0,0,0,12" />
                        <TextBlock Text="F / Esc    全屏 / 退出" Margin="0,0,0,12" />
                        <TextBlock Text="M    静音" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="[ / ]    调整 0.25×" Margin="0,0,0,12" />
                        <TextBlock Text="\    恢复 1.0×" Margin="0,0,0,12" />
                        <TextBlock Text="Ctrl + O    打开视频" Margin="0,0,0,12" />
                        <TextBlock Text="Ctrl + Shift + O    打开文件夹" Margin="0,0,0,12" />
                        <TextBlock Text="Ctrl + ← / →    切换视频" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>