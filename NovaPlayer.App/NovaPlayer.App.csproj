<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>NovaPlayer</AssemblyName>
        <RootNamespace>NovaPlayer.App</RootNamespace>
        <Version>1.0.0-rc.1</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Product>Nova Player</Product>
        <Description>Nova Player 本地视频播放器</Description>
        <ApplicationIcon>Assets/NovaPlayer.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>
    <ItemGroup>
        <Resource Include="Assets/NovaPlayer.ico" />
        <ProjectReference Include="../src/NovaPlayer.Core/NovaPlayer.Core.csproj" />
        <ProjectReference Include="../src/NovaPlayer.Infrastructure/NovaPlayer.Infrastructure.csproj" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <Content Include="../native/win-x64/libmpv-2.dll" Link="native/win-x64/libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../native/win-x64/ffmpeg.exe" Link="native/win-x64/ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Target Name="CheckMpvRuntime" BeforeTargets="PrepareForBuild">
        <Error Condition="!Exists('../native/win-x64/libmpv-2.dll')" Text="Missing libmpv x64 runtime. Run scripts/Setup-Dependencies.ps1 first." />
        <Error Condition="!Exists('../native/win-x64/ffmpeg.exe')" Text="缺少缩略图运行工具，请先执行 scripts/Setup-Dependencies.ps1。" />
    </Target>
</Project>
