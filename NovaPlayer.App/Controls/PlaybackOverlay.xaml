<Window x:Class="NovaPlayer.App.Controls.PlaybackOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        AllowDrop="True" MouseMove="Video_MouseMove" MouseDoubleClick="Video_DoubleClick"
        PreviewKeyDown="Overlay_KeyDown" Drop="Files_Drop">
    <Grid Background="#01080B12">
        <Grid x:Name="TopChrome" VerticalAlignment="Top" Height="120" IsHitTestVisible="False">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C0080B12" Offset="0"/><GradientStop Color="#00080B12" Offset="1"/></LinearGradientBrush></Grid.Background>
            <StackPanel Margin="24,20">
                <TextBlock Text="{Binding FileName}" FontSize="19" FontWeight="SemiBold" Foreground="#F5F7FB" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding VideoInfo}" Margin="0,6,0,0" Foreground="#A7B2C6" FontSize="13"/>
            </StackPanel>
        </Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVisibility}}" MaxWidth="580">
            <TextBlock Text="▶" FontSize="64" Foreground="#3578F6" HorizontalAlignment="Center"/>
            <TextBlock Text="打开视频，开始观看" FontSize="28" Foreground="#F5F7FB" Margin="0,24,0,12" HorizontalAlignment="Center"/>
            <TextBlock Text="选择本地视频，或将视频拖拽至此处" Foreground="#A7B2C6" HorizontalAlignment="Center"/>
            <Button Content="打开视频" Command="{Binding OpenCommand}" IsEnabled="{Binding IsReady}" Style="{StaticResource PrimaryButton}" Margin="0,28,0,0" HorizontalAlignment="Center" MinWidth="140"/>
        </StackPanel>
        <TextBlock Text="正在加载视频…" FontSize="18" Foreground="#F5F7FB" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding State.IsLoading, Converter={StaticResource BoolVisibility}}"/>
        <Grid x:Name="BottomChrome" VerticalAlignment="Bottom" Height="180">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00080B12" Offset="0"/><GradientStop Color="#F2080B12" Offset="1"/></LinearGradientBrush></Grid.Background>
            <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,18">
                <TextBlock Text="{Binding Status}" Foreground="#A7B2C6" FontSize="12" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>
                <DockPanel>
                    <TextBlock Text="{Binding TimeText}" Width="170" VerticalAlignment="Center" Foreground="#F5F7FB" FontSize="13"/>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding SeekMaximum}" Value="{Binding State.Position, Mode=OneWay}" IsMoveToPointEnabled="True" IsEnabled="{Binding State.IsLoaded}" PreviewMouseLeftButtonDown="Seek_Start" PreviewMouseLeftButtonUp="Seek_End" LostMouseCapture="Seek_LostCapture"/>
                </DockPanel>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="打开" Command="{Binding OpenCommand}" IsEnabled="{Binding IsReady}" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="↶ 10" Command="{Binding BackwardCommand}" ToolTip="快退 10 秒"/>
                        <Button Content="{Binding PlayText}" Command="{Binding TogglePauseCommand}" FontSize="24" Width="56" ToolTip="播放 / 暂停（Space）"/>
                        <Button Content="10 ↷" Command="{Binding ForwardCommand}" ToolTip="快进 10 秒"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding MuteText}" Command="{Binding ToggleMuteCommand}" ToolTip="静音（M）"/>
                        <Slider Width="85" Minimum="0" Maximum="100" Value="{Binding State.Volume, Mode=OneWay}" ValueChanged="Volume_Changed" VerticalAlignment="Center" Margin="4,0,16,0"/>
                        <Button x:Name="SpeedButton" Content="{Binding SpeedText}" Click="Speed_Click" MinWidth="80" ToolTip="倍速 0.25～15×"/>
                        <Button Content="⛶" FontSize="22" Command="{Binding FullscreenCommand}" ToolTip="全屏（F）" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
        <Popup x:Name="SpeedPopup" PlacementTarget="{Binding ElementName=SpeedButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#1C2434" BorderBrush="#2B3548" BorderThickness="1" CornerRadius="8" Padding="16" Width="270">
                <StackPanel>
                    <TextBlock Text="播放倍速" Foreground="#F5F7FB" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding SpeedChoices}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding Value, StringFormat={}{0:0.##}×}" Tag="{Binding Value}" Click="PresetSpeed_Click" Margin="2">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#3578F6"/></DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,12,0,8">
                        <Button DockPanel.Dock="Right" Content="应用" Click="CustomSpeed_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="CustomSpeed" Text="1.0" ToolTip="自定义倍速：0.25～15.0" VerticalContentAlignment="Center" Background="#121722" Foreground="#F5F7FB" BorderBrush="#2B3548" Padding="8,4"/>
                    </DockPanel>
                    <Button Content="恢复正常 1.0×" Command="{Binding ResetSpeedCommand}" Click="CloseSpeed_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
