<Window x:Class="NovaPlayer.App.Controls.PlaybackOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NovaPlayer.App.Controls" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" AllowDrop="True" MouseMove="Video_MouseMove" MouseDoubleClick="Video_DoubleClick" PreviewKeyDown="Overlay_KeyDown" Drop="Files_Drop" MouseLeftButtonDown="Video_MouseDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B6C0D2" />
        <SolidColorBrush x:Key="TextMuted" Color="#748198" />
        <SolidColorBrush x:Key="PanelBackground" Color="#1C2434" />
        <SolidColorBrush x:Key="LineBrush" Color="#2B3548" />
        <SolidColorBrush x:Key="HoverBrush" Color="#293851" />
        <SolidColorBrush x:Key="InputBrush" Color="#121722" />
        <Style x:Key="VideoButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ToolTipService.ShowDuration" Value="2000" />
        </Style>
    </Window.Resources>
    <Grid Background="#01080B12">
        <Grid x:Name="TopChrome" VerticalAlignment="Top" Height="110" Visibility="{Binding State.IsLoaded, Converter={StaticResource BoolVisibility}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#C0080B12" Offset="0" />
                    <GradientStop Color="#00080B12" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid Margin="20,18,18,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0" IsHitTestVisible="False">
                    <TextBlock Text="{Binding FileName}" FontSize="17" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetadataLabel" Text="{Binding VideoInfo}" Margin="0,6,0,0" Foreground="#B6C0D2" FontSize="12" />
                </StackPanel>
                <StackPanel x:Name="TopTools" Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding MiniPlayerCommand}" ToolTip="画中画 / 返回主窗口" Foreground="White" Background="#60202B3E" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="pip" Width="18" Height="18" />
                            <TextBlock Text="画中画" Foreground="White" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SubtitleButton" Click="Subtitle_Click" ToolTip="字幕" Foreground="White" Background="#60202B3E" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="subtitles" Width="18" Height="18" />
                            <TextBlock Text="字幕" Foreground="White" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource VideoButton}" Click="More_Click" ToolTip="更多操作">
                        <c:Icon Kind="more" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsMiniPlayer, Converter={StaticResource BoolVisibility}}">
                    <Button Command="{Binding MiniPlayerCommand}" Style="{StaticResource VideoButton}" ToolTip="返回主窗口">
                        <c:Icon Kind="pip" />
                    </Button>
                    <Button Click="CloseMini_Click" Style="{StaticResource VideoButton}" ToolTip="关闭画中画并返回主窗口">
                        <c:Icon Kind="close" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel x:Name="EmptyContent" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVisibility}}" MaxWidth="520" Margin="20">
            <Grid Width="54" Height="58" HorizontalAlignment="Center">
                <Path Data="M6,4 L45,28 Q48,30 45,33 L6,56 Z" StrokeThickness="8" StrokeLineJoin="Round">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4AD4FA" />
                            <GradientStop Color="#3578F6" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Grid>
            <TextBlock x:Name="EmptyTitle" Text="打开视频，开始观看" FontSize="25" Foreground="White" Margin="0,24,0,10" HorizontalAlignment="Center" />
            <TextBlock Text="也可以将视频或文件夹拖拽至此处" Foreground="#8C9AB1" HorizontalAlignment="Center" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Content="打开视频" Command="{Binding OpenCommand}" IsEnabled="{Binding IsReady}" Style="{StaticResource PrimaryButton}" MinWidth="116" />
                <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding IsReady}" Background="#202A3D" Foreground="White" Margin="12,0,0,0" Padding="16,8" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="正在加载视频…" FontSize="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding State.IsLoading, Converter={StaticResource BoolVisibility}}" />
        <Grid x:Name="BottomChrome" VerticalAlignment="Bottom" Height="152">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00080B12" Offset="0" />
                    <GradientStop Color="#EE080B12" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,16">
                <TextBlock x:Name="PlayerStatus" Text="{Binding Status}" Foreground="#91A1BB" FontSize="11" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
                <DockPanel>
                    <TextBlock Text="{Binding TimeText}" Width="152" VerticalAlignment="Center" Foreground="White" FontSize="12" />
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding SeekMaximum}" Value="{Binding State.Position, Mode=OneWay}" IsMoveToPointEnabled="True" IsEnabled="{Binding State.IsLoaded}" PreviewMouseLeftButtonDown="Seek_Start" PreviewMouseLeftButtonUp="Seek_End" LostMouseCapture="Seek_LostCapture" PreviewMouseMove="Seek_Hover" Height="20" VerticalAlignment="Center" />
                </DockPanel>
                <Grid x:Name="NormalControls" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource VideoButton}" Command="{Binding TogglePlaylistCommand}" ToolTip="展开 / 收起播放列表">
                            <c:Icon Kind="list" />
                        </Button>
                        <Button Style="{StaticResource VideoButton}" Command="{Binding ToggleInformationCommand}" ToolTip="展开 / 收起底部信息">
                            <c:Icon Kind="info" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource VideoButton}" Command="{Binding PreviousCommand}" ToolTip="上一个视频">
                            <c:Icon Kind="previous" Width="17" Height="17" />
                        </Button>
                        <Button Style="{StaticResource VideoButton}" Command="{Binding BackwardCommand}" ToolTip="快退 10 秒">
                            <Grid>
                                <c:Icon Kind="back" />
                                <TextBlock Text="10" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource VideoButton}" Command="{Binding TogglePauseCommand}" Width="48" Height="40" ToolTip="播放 / 暂停（Space）">
                            <c:Icon Kind="{Binding PlayIcon}" Width="27" Height="27" />
                        </Button>
                        <Button Style="{StaticResource VideoButton}" Command="{Binding ForwardCommand}" ToolTip="快进 10 秒">
                            <Grid>
                                <c:Icon Kind="forward" />
                                <TextBlock Text="10" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource VideoButton}" Command="{Binding NextCommand}" ToolTip="下一个视频">
                            <c:Icon Kind="next" Width="17" Height="17" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource VideoButton}" Command="{Binding ToggleMuteCommand}" ToolTip="静音（M）">
                            <c:Icon Kind="{Binding VolumeIcon}" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="72" Minimum="0" Maximum="100" Value="{Binding State.Volume, Mode=OneWay}" ValueChanged="Volume_Changed" VerticalAlignment="Center" Margin="4,0,14,0" />
                        <Button x:Name="SpeedButton" Click="Speed_Click" MinWidth="74" ToolTip="倍速 0.25～15×" Foreground="White" Background="#A020293A">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SpeedText}" Foreground="White" />
                                <c:Icon Kind="down" Width="12" Height="12" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource VideoButton}" Command="{Binding FullscreenCommand}" ToolTip="全屏（F）" Margin="12,0,0,0">
                            <c:Icon Kind="fullscreen" />
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="MiniControls" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding IsMiniPlayer, Converter={StaticResource BoolVisibility}}">
                    <Button Style="{StaticResource VideoButton}" Command="{Binding BackwardCommand}">
                        <c:Icon Kind="back" />
                    </Button>
                    <Button Style="{StaticResource VideoButton}" Command="{Binding TogglePauseCommand}">
                        <c:Icon Kind="{Binding PlayIcon}" />
                    </Button>
                    <Button Style="{StaticResource VideoButton}" Command="{Binding ForwardCommand}">
                        <c:Icon Kind="forward" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Border VerticalAlignment="Bottom" Background="#182132" CornerRadius="8" Padding="12,6" Margin="16" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ToggleInformationCommand}" Content="底部信息" Foreground="#A7B2C6" Padding="8,3" />
                <Button DockPanel.Dock="Right" Command="{Binding TogglePlaylistCommand}" Content="播放列表" Foreground="#A7B2C6" Padding="8,3" />
                <TextBlock Text="{Binding Status}" Foreground="#91A1BB" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" />
            </DockPanel>
        </Border>
        <Popup x:Name="SpeedPopup" PlacementTarget="{Binding ElementName=SpeedButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#1C2434" BorderBrush="#2B3548" BorderThickness="1" CornerRadius="8" Padding="16" Width="270">
                <StackPanel>
                    <TextBlock Text="播放倍速" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding SpeedChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Value, StringFormat={}{0:0.##}×}" Tag="{Binding Value}" Click="PresetSpeed_Click" Margin="2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#3578F6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,12,0,8">
                        <Button DockPanel.Dock="Right" Content="应用" Click="CustomSpeed_Click" Margin="8,0,0,0" Foreground="White" />
                        <TextBox x:Name="CustomSpeed" Text="1.0" ToolTip="自定义倍速：0.25～15.0" Background="#121722" Foreground="White" />
                    </DockPanel>
                    <Button Content="恢复正常 1.0×" Command="{Binding ResetSpeedCommand}" Click="CloseSpeed_Click" Foreground="White" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>