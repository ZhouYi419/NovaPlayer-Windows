<UserControl x:Class="NovaPlayer.App.Controls.VideoThumbnail" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NovaPlayer.App.Controls">
    <Grid Background="Transparent">
        <c:Icon Kind="video" Width="26" Height="26" Foreground="{DynamicResource TextMuted}" />
        <Image Source="{Binding Item.Thumbnail, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="UniformToFill" />
    </Grid>
</UserControl>
