<Window x:Class="NovaPlayer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NovaPlayer.App.Controls" xmlns:v="clr-namespace:NovaPlayer.App.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Nova Player" Width="1440" Height="900" MinWidth="960" MinHeight="620" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" AllowDrop="True" Drop="Files_Drop" PreviewKeyDown="Player_KeyDown" SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="46" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="VideoPlaceholder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Resources>
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="64" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="190" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid x:Name="Header" Grid.ColumnSpan="2" Margin="12,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="178" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding NavigateCommand}" CommandParameter="首页" shell:WindowChrome.IsHitTestVisibleInChrome="True" HorizontalContentAlignment="Left" ToolTip="返回首页">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="32" Height="36" Margin="0,0,12,0">
                        <Path Data="M4,2 L29,17 Q32,19 29,21 L4,35 Z" StrokeThickness="6" StrokeLineJoin="Round">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4AD4FA" />
                                    <GradientStop Color="#3578F6" Offset="0.7" />
                                    <GradientStop Color="#3552DC" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>
                    </Grid>
                    <TextBlock Text="Nova Player" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Grid Grid.Column="1" MaxWidth="440" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=SearchHost}" Margin="18,0,24,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,9,12,9" Height="38" ToolTip="搜索已添加或观看过的视频" />
                <c:Icon Kind="search" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="搜索本地视频…" Foreground="{DynamicResource TextMuted}" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Popup IsOpen="{Binding ShowSearch, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True">
                    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Width="440" Margin="0,5,0,0">
                        <StackPanel>
                            <DockPanel Margin="8,4,0,8">
                                <Button DockPanel.Dock="Right" Content="关闭" Click="CloseSearch_Click" />
                                <TextBlock Text="本地搜索结果" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="没有匹配的视频" Margin="8" Foreground="{DynamicResource TextMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchResults.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="320">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PlayVideoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SearchDetail}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <Border x:Name="SearchHost" Grid.Column="1" Margin="18,0,24,0" MaxWidth="440" IsHitTestVisible="False" Visibility="Hidden" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Command="{Binding OpenCommand}" IsEnabled="{Binding IsReady}" ToolTip="打开视频（Ctrl+O）" Margin="0,0,10,0">
                    <c:Icon Kind="folder" />
                </Button>
                <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="Theme_Click" ToolTip="主题" Margin="0,0,20,0">
                    <c:Icon Kind="theme" />
                </Button>
                <Border Background="{DynamicResource LineBrush}" Width="1" Height="22" Margin="0,0,10,0" />
                <Button Width="44" Click="Minimize_Click" ToolTip="最小化">
                    <c:Icon Kind="minimize" Width="18" Height="18" />
                </Button>
                <Button Width="44" Click="Maximize_Click" ToolTip="最大化 / 还原">
                    <c:Icon Kind="maximize" Width="16" Height="16" />
                </Button>
                <Button Width="44" Click="Close_Click" ToolTip="关闭">
                    <c:Icon Kind="close" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Grid>
        <Border x:Name="Sidebar" Grid.Row="1" Background="{DynamicResource NavBackground}" Margin="0,0,12,0">
            <Grid Margin="12,20,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="首页" ToolTip="首页">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHome}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                        <Setter Property="Foreground" Value="#7DAAFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="home" Width="22" Height="22" />
                            <TextBlock x:Name="HomeLabel" Text="首页" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="播放历史" ToolTip="播放历史">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHistory}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                        <Setter Property="Foreground" Value="#7DAAFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="history" Width="22" Height="22" />
                            <TextBlock x:Name="HistoryLabel" Text="播放历史" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="设置" ToolTip="设置">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                        <Setter Property="Foreground" Value="#7DAAFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="settings" Width="22" Height="22" />
                            <TextBlock x:Name="SettingsLabel" Text="设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border x:Name="RecentCard" Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentVideo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Button Command="{Binding PlayVideoCommand}" CommandParameter="{Binding RecentVideo}" Padding="0">
                            <Border Width="134" Height="72" Style="{StaticResource VideoPlaceholder}">
                                <c:Icon Kind="video" Width="30" Height="30" Foreground="{DynamicResource TextMuted}" />
                            </Border>
                        </Button>
                        <TextBlock Text="最近观看" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,10,0,6" />
                        <TextBlock Text="{Binding RecentVideo.Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecentVideo.Path}" />
                        <ProgressBar Value="{Binding RecentVideo.Percentage, Mode=OneWay}" Maximum="100" Margin="0,12,0,8" />
                        <Button Content="继续观看  ›" Command="{Binding PlayVideoCommand}" CommandParameter="{Binding RecentVideo}" Foreground="#7DAAFF" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid x:Name="HomeShell" Grid.Row="1" Grid.Column="1" Margin="0,4,18,18" Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition x:Name="InformationRow" Height="210" />
            </Grid.RowDefinitions>
            <Border x:Name="PlayerFrame" Background="#080B12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition x:Name="PlaylistColumn" Width="312" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Viewport" CornerRadius="12" Background="#080B12">
                        <Grid x:Name="VideoContainer" />
                    </Border>
                    <Border x:Name="PlaylistPanel" Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" CornerRadius="0,12,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition />
                                <RowDefinition Height="50" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="18,0,12,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding TogglePlaylistCommand}" ToolTip="收起播放列表">
                                    <c:Icon Kind="chevron" Width="17" Height="17" />
                                </Button>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PlaylistIndex}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,8,0" />
                                <TextBlock Text="播放列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="PlaylistList" Grid.Row="1" ItemsSource="{Binding Playlist}" Margin="6,0" AllowDrop="True" PreviewMouseLeftButtonDown="Playlist_MouseDown" PreviewMouseMove="Playlist_MouseMove" Drop="Playlist_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Margin="0,0,0,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.ColumnSpan="2" Command="{Binding DataContext.PlayVideoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0" Height="68">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource VideoPlaceholder}" Height="52" Width="70">
                                                            <c:Icon Kind="video" Width="23" Height="23" Foreground="{DynamicResource TextMuted}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Foreground" Value="#7DAAFF" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource TextMuted}" Margin="0,7,0,0" FontSize="12" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="2" Click="QueueMore_Click" Tag="{Binding}" Style="{StaticResource IconButton}" Width="28" ToolTip="视频操作">
                                                    <c:Icon Kind="more" Width="16" Height="16" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPlaylist}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <c:Icon Kind="list" Width="32" Height="32" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="播放列表为空" Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,6" />
                                <TextBlock Text="添加视频，按你的顺序观看" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                            </StackPanel>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="＋ 添加视频" Command="{Binding OpenCommand}" />
                                    <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Grid x:Name="InformationArea" Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition x:Name="QuickColumn" Width="340" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition x:Name="QuickRow" Height="0" />
                </Grid.RowDefinitions>
                <Border x:Name="InformationCard" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,18,0">
                    <TabControl SelectedIndex="{Binding InformationTab}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="history" Width="17" Height="17" />
                                    <TextBlock Text="播放记录" Margin="8,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentVideo}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource VideoPlaceholder}" Width="80" Height="60">
                                    <c:Icon Kind="video" Width="26" Height="26" Foreground="{DynamicResource TextMuted}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" />
                                        <ProgressBar Value="{Binding CurrentVideo.Percentage, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding CurrentVideo.LastPlayedText}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,7,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding PlayText}" Command="{Binding TogglePauseCommand}" Style="{StaticResource SurfaceButton}" />
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="info" Width="17" Height="17" />
                                    <TextBlock Text="视频信息" Margin="8,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding State.FilePath, TargetNullValue=尚未打开视频}" TextTrimming="CharacterEllipsis" ToolTip="{Binding State.FilePath}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Resolution}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,20,6" />
                                        <TextBlock Text="{Binding CurrentVideo.SizeText}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,20,6" />
                                        <TextBlock Text="{Binding FrameRate}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,20,6" />
                                        <TextBlock Text="{Binding State.VideoCodec}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,20,6" />
                                        <TextBlock Text="{Binding State.AudioCodec}" Foreground="{DynamicResource TextSecondary}" />
                                    </WrapPanel>
                                    <Button Content="打开文件所在位置" Command="{Binding RevealCommand}" HorizontalAlignment="Left" Padding="0,4" Foreground="#7DAAFF" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="keyboard" Width="17" Height="17" />
                                    <TextBlock Text="快捷键" Margin="8,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                </StackPanel>
                            </TabItem.Header>
                            <StackPanel>
                                <TextBlock Text="Space 播放 / 暂停    ← → 快退 / 快进    F 全屏" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                <TextBlock Text="[ / ] 调整倍速    M 静音    Ctrl + O 打开视频" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Button Content="查看全部快捷键  ›" Command="{Binding ShowShortcutsCommand}" HorizontalAlignment="Left" Padding="0,6" Foreground="#7DAAFF" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>
                <Border x:Name="QuickSettings" Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ToggleInformationCommand}" ToolTip="收起底部信息">
                                <c:Icon Kind="down" Width="14" Height="14" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="settings" Width="18" Height="18" />
                                <TextBlock Text="播放设置" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel x:Name="ResumeSetting" Grid.ColumnSpan="2">
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Preferences.AutoResume}" />
                                <StackPanel>
                                    <TextBlock Text="自动续播" />
                                    <TextBlock Text="再次打开时继续上次观看位置" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,6,8,0" />
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="QuickSeparator" Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource LineBrush}" Margin="0,14,0,12" />
                            <DockPanel x:Name="SpeedSetting" Grid.Row="2" Grid.ColumnSpan="2">
                                <ComboBox DockPanel.Dock="Right" Width="90" ItemsSource="{Binding Speeds}" ItemTemplate="{StaticResource SpeedValueTemplate}" SelectedItem="{Binding Preferences.DefaultSpeed}" />
                                <TextBlock Text="默认倍速" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <v:HistoryView Grid.Row="1" Grid.Column="1" Visibility="{Binding IsHistory, Converter={StaticResource BoolVisibility}}" />
        <v:SettingsView Grid.Row="1" Grid.Column="1" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" />
    </Grid>
</Window>