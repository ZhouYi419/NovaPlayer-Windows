<Window x:Class="NovaPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nova Player" Width="1440" Height="900" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#121722" Foreground="#F5F7FB"
        AllowDrop="True" Drop="Files_Drop" PreviewKeyDown="Player_KeyDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions>
        <Border x:Name="Header" BorderBrush="#2B3548" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0">
                <Button DockPanel.Dock="Right" Content="打开视频   Ctrl+O" Command="{Binding OpenCommand}" IsEnabled="{Binding IsReady}" Style="{StaticResource PrimaryButton}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▶" FontSize="26" Foreground="#3578F6" Margin="0,0,12,0"/>
                    <TextBlock Text="Nova Player" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#1C2434" CornerRadius="5" Margin="18,0,0,0" Padding="10,5">
                        <TextBlock Text="播放器内核验证" Foreground="#A7B2C6" FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="Viewport" Grid.Row="1" Margin="20,16,20,0" Background="#080B12" BorderBrush="#2B3548" BorderThickness="1">
            <Grid x:Name="VideoContainer"/>
        </Border>
        <DockPanel x:Name="Footer" Grid.Row="2" Margin="24,0">
            <TextBlock Text="GPU Render API · 本地离线" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#748198" FontSize="12"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#A7B2C6" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
